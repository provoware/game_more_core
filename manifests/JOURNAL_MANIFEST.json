  "event_types": ["character.profile_updated","character.skill_xp_gained","character.skill_level_up","character.trait_evidence_gained","character.trait_unlocked","character.trait_tier_up","character.specialization_changed","character.level_up","character.resonance_rank_up","character.biography_entry_added","training.started","training.completed","training.cancelled","mission.started","mission.progressed","mission.completed","mission.failed","inventory.item_acquired","inventory.item_removed","economy.transaction_posted","economy.transaction_compensated","club.created","club.updated","club.share_transaction","world.location_discovered","world.location_updated","event.planning_updated","event.started","event.incident_resolved","event.completed","sync.local_enqueued","sync.server_confirmed","sync.conflict_detected","sync.conflict_resolved","system.autosave_committed","system.snapshot_created","system.recovery_performed","system.migration_completed","time.anchor_confirmed"],
