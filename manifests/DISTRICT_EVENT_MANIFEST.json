{
  "schema_version": 1,
  "version": "0.8.8-chain-v1",
  "district_state_manifest_version": "0.8.5-d1",
  "city_map_manifest_version": "0.8.3-b2-foundation",
  "selection": {
    "method": "sha256_stable_weighted",
    "weight_total": 100,
    "seed_fields": ["world_seed", "district_id", "trigger_id"],
    "system_time_as_seed": false,
    "reroll_on_reload": false
  },
  "activation_policy": {
    "maximum_active_instances_per_context": 1,
    "client_can_activate": false,
    "client_can_supply_effects": false,
    "effects_apply_only_after_confirmed_resolution": true
  },
  "cadence": {
    "authority": "confirmed_event_game_world_time",
    "timestamp_source": "event.time_window.start_local",
    "minimum_hours_between_events": 24,
    "scope": "global",
    "system_time_is_sole_authority": false
  },
  "effect_contract": {
    "metrics": ["heat", "prestige", "police_pressure", "scene_activity"],
    "per_event_delta_minimum": -6,
    "per_event_delta_maximum": 6,
    "district_bounds_remain": {"minimum": 0, "maximum": 100}
  },
  "follow_up_contract": {
    "journal_event_type": "world.district_followup_resolved",
    "parent_event_type": "world.district_effect_applied",
    "required_payload_fields": ["parent_event_id", "district_id", "followup_id"],
    "causation_id_source": "parent_event_id",
    "correlation_id_pattern": "district-chain:{parent_event_id}",
    "event_id_pattern": "district-followup:{parent_event_id}:{followup_id}",
    "replay_policy": "same_event_id_same_payload_is_idempotent",
    "district_must_match_parent": true,
    "runtime_authority_only": true,
    "client_can_write": false
  },
  "events": [
    {
      "event_id": "district.power_flicker",
      "weight": 28,
      "title_key": "district_event.power_flicker.title",
      "body_key": "district_event.power_flicker.body",
      "requirements": {"minimum_scene_activity": 20},
      "effects": {"heat": 0, "prestige": -1, "police_pressure": 0, "scene_activity": -3}
    },
    {
      "event_id": "district.word_of_mouth_wave",
      "weight": 30,
      "title_key": "district_event.word_of_mouth_wave.title",
      "body_key": "district_event.word_of_mouth_wave.body",
      "requirements": {"minimum_prestige": 15},
      "effects": {"heat": 1, "prestige": 3, "police_pressure": 0, "scene_activity": 4}
    },
    {
      "event_id": "district.patrol_sweep",
      "weight": 22,
      "title_key": "district_event.patrol_sweep.title",
      "body_key": "district_event.patrol_sweep.body",
      "requirements": {"minimum_heat": 20},
      "effects": {"heat": -2, "prestige": 0, "police_pressure": 5, "scene_activity": -2}
    },
    {
      "event_id": "district.temporary_space_opens",
      "weight": 20,
      "title_key": "district_event.temporary_space_opens.title",
      "body_key": "district_event.temporary_space_opens.body",
      "requirements": {"maximum_police_pressure": 60},
      "effects": {"heat": 1, "prestige": 2, "police_pressure": 0, "scene_activity": 5}
    }
  ]
}
