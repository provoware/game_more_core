{
  "schema_version": 1,
  "version": "0.5.2-alpha.1",
  "runtime": "python_stdlib_headless",
  "external_dependencies": [],
  "modules": {
    "character_state": "src/bunkerfrequenz/domain/character.py",
    "progression": "src/bunkerfrequenz/domain/progression.py",
    "trait_effects": "src/bunkerfrequenz/domain/trait_effects.py",
    "action_resolver": "src/bunkerfrequenz/application/action_resolver.py",
    "character_action_service": "src/bunkerfrequenz/application/character_action_service.py",
    "profile_service": "src/bunkerfrequenz/application/profile_service.py",
    "recovery_service": "src/bunkerfrequenz/application/recovery_service.py",
    "persistence_kernel": "src/bunkerfrequenz/infrastructure/persistence.py"
  },
  "contracts": [
    "manifests/PROGRESSION_MANIFEST.json",
    "manifests/TRAIT_ENGINE_MANIFEST.json",
    "manifests/ACTION_MANIFEST.json",
    "manifests/JOURNAL_MANIFEST.json",
    "manifests/PERSISTENCE_MANIFEST.json"
  ],
  "recovery": {
    "state_envelope_version": 1,
    "snapshot_schema_version": 1,
    "recovery_receipt_schema_version": 1,
    "snapshot_event_threshold": 50,
    "snapshot_time_threshold_seconds": 300,
    "fault_points": ["after_journal_durable", "after_state_applied", "after_meta_committed"],
    "one_step_profile_undo": true,
    "corrupt_tail_quarantine": true,
    "snapshot_plus_journal_replay": true
  },
  "invariants": [
    "all_characters_start_with_equal_skill_values",
    "action_resolution_is_deterministic_for_equal_inputs",
    "system_time_is_not_random_seed",
    "actions_do_not_mutate_input_character_state",
    "only_catalogued_journal_events_may_be_persisted_when_catalog_is_supplied",
    "journal_is_durable_before_derived_state_write",
    "duplicate_event_id_with_equal_payload_is_idempotent",
    "duplicate_event_id_with_different_payload_is_rejected",
    "recovery_replay_must_not_double_apply_derived_level_or_trait_events",
    "corrupt_journal_tail_is_quarantined_before_repair",
    "recovery_is_idempotent_after_a_recovered_checkpoint_is_committed",
    "trait_effects_match_the_trait_engine_manifest",
    "trait_effects_are_capped_per_runtime_target",
    "level_50_continues_as_open_ended_journaled_resonance"
  ],
  "validation": {
    "compile_command": "PYTHONPATH=src python3 -m compileall -q src",
    "unit_command": "PYTHONPATH=src python3 -m unittest discover -s tests/runtime -v",
    "reference_report": "reports/RUNTIME_VALIDATION_0.5.2.json"
  }
}
