{
  "schema_version": 1,
  "policy_id": "bunkerfrequenz.release-autopilot-pro.v1",
  "product": "BUNKERFREQUENZ",
  "release_states": [
    "RELEASE_READY",
    "QUARANTINE",
    "RELEASE_BLOCKED",
    "RELEASE_INVALID"
  ],
  "build_isolation": {
    "clean_worktree_required": true,
    "tracked_source_only": true,
    "independent_build_directories": 2,
    "rebuild_after_validation": false
  },
  "candidate_requirements": [
    "source_tree_frozen",
    "reproducible_build",
    "file_manifest_verified",
    "embedded_policy_verified",
    "clean_room_start",
    "clean_room_api_state"
  ],
  "public_promotion_required_subgates": [
    "desktop_browser_e2e_pro",
    "failure_containment_pro"
  ],
  "subgate_evidence_binding": {
    "source_commit_required": true,
    "source_tree_required": true,
    "candidate_sha256_required": true,
    "pass_requires_evidence_sha256": true
  },
  "promotion": {
    "rebuild_after_validation": false,
    "copy_validated_candidate_only": true,
    "sha256_must_match_candidate": true,
    "quarantine_blocks_user_zip": true,
    "blocked_blocks_user_zip": true,
    "invalid_blocks_user_zip": true
  },
  "anti_flake": {
    "retry_can_diagnose": true,
    "retry_can_turn_failure_green": false,
    "inconsistent_runs_state": "QUARANTINE"
  },
  "evidence": {
    "root_file": "RELEASE_EVIDENCE.json",
    "root_sha256_file": "RELEASE_EVIDENCE.json.sha256",
    "required_fields": [
      "policy_sha256",
      "source_commit",
      "source_tree",
      "candidate_sha256",
      "candidate_size_bytes",
      "file_manifest_sha256",
      "candidate_checks",
      "subgates",
      "release_state"
    ]
  },
  "automatic_repair_boundaries": {
    "system_package_install": false,
    "sudo": false,
    "user_data_delete": false,
    "gameplay_state_mutation": false
  }
}
