{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.de/schemas/bunkerfrequenz/settlement_state.schema.json",
  "title": "BUNKERFREQUENZ SettlementState",
  "type": "object",
  "required": [
    "event_id",
    "settlement_id",
    "contract_version",
    "incident_ids",
    "effects",
    "budget",
    "character_id",
    "stress",
    "reputation",
    "event_revision",
    "economy_revision",
    "incident_revision",
    "status",
    "revision"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "settlement_id": {"type": "string", "minLength": 1},
    "contract_version": {"enum": ["0.8.3-c1", "0.8.8-venue-evidence-v1"]},
    "venue_evidence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "schema_version",
            "location_id",
            "owner_character_id",
            "audience_pull",
            "city_map_manifest_version",
            "property_upgrade_manifest_version",
            "property_revision",
            "property_upgrade_revision"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "location_id": {
              "type": "string",
              "minLength": 1
            },
            "owner_character_id": {
              "type": "string",
              "minLength": 1
            },
            "audience_pull": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "city_map_manifest_version": {
              "type": "string",
              "minLength": 1
            },
            "property_upgrade_manifest_version": {
              "type": "string",
              "minLength": 1
            },
            "property_revision": {
              "type": "integer",
              "minimum": 0
            },
            "property_upgrade_revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "incident_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "effects": {
      "type": "object",
      "required": ["budget_delta_cents", "reputation_delta", "crew_stress_delta", "stability_delta", "heat_delta"],
      "properties": {
        "budget_delta_cents": {"type": "integer"},
        "reputation_delta": {"type": "integer"},
        "crew_stress_delta": {"type": "integer"},
        "stability_delta": {"type": "integer"},
        "heat_delta": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "budget": {"$ref": "#/$defs/unboundedTriplet"},
    "character_id": {"type": "string", "minLength": 1},
    "stress": {"$ref": "#/$defs/resourceTriplet"},
    "reputation": {"$ref": "#/$defs/reputationTriplet"},
    "event_revision": {"$ref": "#/$defs/revisionPair"},
    "economy_revision": {"$ref": "#/$defs/revisionPair"},
    "incident_revision": {"$ref": "#/$defs/revisionPair"},
    "status": {"const": "completed"},
    "revision": {"const": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract_version": {
            "const": "0.8.8-venue-evidence-v1"
          }
        }
      },
      "then": {
        "required": [
          "venue_evidence"
        ]
      },
      "else": {
        "not": {
          "required": [
            "venue_evidence"
          ]
        }
      }
    }
  ],
  "$defs": {
    "unboundedTriplet": {
      "type": "object",
      "required": ["old", "delta", "new"],
      "properties": {
        "old": {"type": "integer"},
        "delta": {"type": "integer"},
        "new": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "reputationTriplet": {
      "type": "object",
      "required": ["old", "delta", "new"],
      "properties": {
        "old": {"type": "integer"},
        "delta": {"type": "integer"},
        "new": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "resourceTriplet": {
      "type": "object",
      "required": ["old", "delta", "new"],
      "properties": {
        "old": {"type": "integer", "minimum": 0, "maximum": 100},
        "delta": {"type": "integer"},
        "new": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "revisionPair": {
      "type": "object",
      "required": ["old", "new"],
      "properties": {
        "old": {"type": "integer", "minimum": 0},
        "new": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
