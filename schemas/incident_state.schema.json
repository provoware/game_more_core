{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/incident_state.schema.json",
  "title": "BUNKERFREQUENZ IncidentState 0.8.3-B1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "active", "history", "pending_settlement", "revision"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "active": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["incident_id", "incident_type", "severity", "status", "phase_origin", "response_ids", "contract_version"],
          "properties": {
            "incident_id": {"type": "string", "minLength": 1},
            "incident_type": {"type": "string", "minLength": 1},
            "severity": {"type": "integer", "minimum": 1, "maximum": 5},
            "status": {"const": "open"},
            "phase_origin": {"const": "live"},
            "response_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "contract_version": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "history": {"type": "array", "items": {"type": "object"}},
    "pending_settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_delta_cents", "reputation_delta", "crew_stress_delta", "stability_delta", "heat_delta"],
      "properties": {
        "budget_delta_cents": {"type": "integer"},
        "reputation_delta": {"type": "integer"},
        "crew_stress_delta": {"type": "integer"},
        "stability_delta": {"type": "integer"},
        "heat_delta": {"type": "integer"}
      }
    },
    "revision": {"type": "integer", "minimum": 0}
  }
}
