{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.de/schemas/bunkerfrequenz/character_state.schema.json",
  "title": "BUNKERFREQUENZ CharacterState",
  "type": "object",
  "required": ["character_id", "display_name", "level", "total_xp", "resonance_xp", "resonance_rank", "skills", "skill_xp", "trait_evidence", "trait_progress", "traits", "energy", "stress", "reputation"],
  "properties": {
    "character_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "alias": {"type": "string"},
    "additional_nicknames": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "motto": {"type": "string"},
    "level": {"type": "integer", "minimum": 1, "maximum": 50},
    "total_xp": {"type": "integer", "minimum": 0},
    "resonance_xp": {"type": "integer", "minimum": 0},
    "resonance_rank": {"type": "integer", "minimum": 0},
    "skills": {"type": "object", "minProperties": 16, "maxProperties": 16, "additionalProperties": {"type": "integer", "minimum": 10, "maximum": 100}},
    "skill_xp": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "trait_evidence": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
    "trait_progress": {"type": "object"},
    "traits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}},
    "specialization": {"type": ["object", "null"]},
    "energy": {"type": "integer", "minimum": 0, "maximum": 100},
    "stress": {"type": "integer", "minimum": 0, "maximum": 100},
    "reputation": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
