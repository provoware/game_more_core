{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/city_map.schema.json",
  "title": "BUNKERFREQUENZ City Map Foundation 0.8.3-B2",
  "type": "object",
  "required": ["schema_version", "version", "map_id", "geography_mode", "coordinate_system", "visual_style", "district_metric_defaults", "highlight_thresholds", "districts", "locations", "property_upgrade_catalog"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"const": "0.8.3-b2-foundation"},
    "map_id": {"const": "berlin_ops"},
    "geography_mode": {"const": "stylized_game_map_not_navigation"},
    "coordinate_system": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {"min": {"const": 0}, "max": {"const": 100}}
    },
    "district_metric_defaults": {
      "type": "object",
      "required": ["heat", "prestige", "police_pressure", "scene_activity"],
      "additionalProperties": false,
      "properties": {
        "heat": {"type": "integer", "minimum": 0, "maximum": 100},
        "prestige": {"type": "integer", "minimum": 0, "maximum": 100},
        "police_pressure": {"type": "integer", "minimum": 0, "maximum": 100},
        "scene_activity": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "districts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "locations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "highlight_thresholds": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "property_upgrade_catalog": {"type": "array", "items": {"type": "object"}},
    "visual_style": {"type": "object"}
  }
}
