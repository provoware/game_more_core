{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/property_upgrade_state.schema.json",
  "title": "BUNKERFREQUENZ PropertyUpgradeState 0.8.6-B",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "revision", "properties"],
  "properties": {
    "contract_version": {"const": "0.8.6-b1"},
    "revision": {"type": "integer", "minimum": 0},
    "properties": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location_id", "upgrades"],
        "properties": {
          "location_id": {"type": "string", "minLength": 1},
          "upgrades": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "economy_transaction_ids"],
              "properties": {
                "level": {"type": "integer", "minimum": 1, "maximum": 3},
                "economy_transaction_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
